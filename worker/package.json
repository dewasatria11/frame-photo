{
  "name": "lensflow-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && wrangler deploy --dry-run",
    "db:migrate:local": "wrangler d1 migrations apply lensflow --local",
    "db:migrate:remote": "wrangler d1 migrations apply lensflow --remote"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.2",
    "hono": "^4.9.6",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260826.1",
    "typescript": "^5.9.2",
    "wrangler": "^4.127.0"
  }
}
